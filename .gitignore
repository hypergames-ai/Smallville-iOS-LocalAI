# Swift / SwiftPM
.build/
.swiftpm/
Packages/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
**/xcuserdata/
DerivedData/

# Generated by XcodeGen (regenerate with `cd App && xcodegen generate`)
App/Smallville.xcodeproj/
App/Info.plist

# Personal signing config (copy from Local.xcconfig.example)
App/Config/Local.xcconfig

# Third-party art and map data (fetched by scripts/fetch-assets.sh, never committed)
Assets/ThirdParty/

# Claude Code: personal settings stay local; shared settings are committed
.claude/settings.local.json
.claude/worktrees/

# Simulation outputs and benchmarks
runs/
*.benchmark.json

# macOS
.DS_Store
!Assets/ThirdParty/.gitkeep-note.md
